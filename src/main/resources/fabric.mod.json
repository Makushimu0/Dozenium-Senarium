{
	"schemaVersion": 1,
	"id": "neosenarium",
	"version": "${version}",
	"name": "NeoSenarium",
	"description": "I cast all numbers are now sezimal!",
	"authors": [
		"Makushimu"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/neosenarium/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"name.modid.NeoSenarium"
		],
		"client": [
			"name.modid.NeoSenariumClient"
		],
		"modmenu": [
			"name.modid.config.ModMenuIntegration"
		]
	},
	"mixins": [
